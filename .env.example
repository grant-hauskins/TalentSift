# Copy to .env and fill in. Never commit .env.

# --- AI provider ---------------------------------------------------------------
# "openrouter" for real screening, "fake" for the deterministic offline client.
# Empty = openrouter when OPENROUTER_API_KEY is set, otherwise fake (so a fresh copy runs offline).
LLM_PROVIDER=
OPENROUTER_API_KEY=
# Any OpenRouter model slug. Prefer models listed with "structured outputs" support at
# https://openrouter.ai/models?supported_parameters=structured_outputs
# Others still work through the plain-JSON fallback. Claude is the default; the Settings page offers
# a short list (talentsift/model_catalog.py) and also accepts any other model id.
LLM_MODEL=anthropic/claude-sonnet-4.5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4000
LLM_CONCURRENCY=4
# Per screening batch, in USD. The run stops cleanly when the cap is reached.
COST_CAP_USD=2.00

# --- Screening policy ----------------------------------------------------------
# automatic (team decision) | confirm (manager approves each batch of rejections)
AUTO_REJECT_MODE=automatic
# Points subtracted for each must-have scored 0-1 (floor 0).
MUST_HAVE_PENALTY=15
MAX_RESUME_CHARS=24000

# --- Privacy ---------------------------------------------------------------------
MASK_GRAD_YEARS=false
# A resume whose name could not be found and masked is never sent to the AI; a person reviews it.
REQUIRE_NAME_MASK=true

# --- Storage and demo ------------------------------------------------------------
# By default the database, uploaded resumes, and backups live in ./data. On a server, point this at a
# folder outside the code checkout (for example /var/lib/talentsift) so updates never touch your data.
# TALENTSIFT_DATA_DIR=/var/lib/talentsift
# Or set the pieces one by one (these win over TALENTSIFT_DATA_DIR):
# DATABASE_URL=sqlite:///data/talentsift.db
# UPLOAD_DIR=data/resumes/uploads
# BACKUP_DIR=data/backups
# How many backups scripts/backup.py keeps.
BACKUP_KEEP=14
# Folder import reads the disk of the machine running TalentSift. On a shared or hosted install, turn it
# off, or limit it to one folder.
ALLOW_FOLDER_IMPORT=true
# IMPORT_ROOT=/srv/talentsift/inbox
# Load the sample roles and resumes automatically when the database is empty
# (useful on Streamlit Community Cloud, whose disk resets on reboot).
AUTO_SEED_DEMO=false
